{
  "name": "alarmops",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "db"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:engine": "cd services/alarm-engine && python -m pytest",
    "lint:engine": "cd services/alarm-engine && python -m ruff check . && python -m mypy"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
