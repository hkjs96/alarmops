  CUSTOMER
}

enum Statistic {
  Average
  Sum
  Minimum
  Maximum
  SampleCount
}

enum ValueSource {
  CODE
  MSP
  CUSTOMER
  CONSOLE
  TAG
}

enum AlarmState {
