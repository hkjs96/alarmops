  RECONCILE
}

enum IncidentEventKind {
  TRIGGERED
  MERGED
  ACKED
  RESOLVED
  ESCALATED
  NOTIFIED
  RENOTIFIED
  SUPPRESSED
  MUTED
  REMEDIATION
  NOTE
}

enum ActorType {
  USER
  CONTACT
  SYSTEM
  PROVIDER
}

enum ResolutionVia {
  MANUAL
  AUTO
}

enum ResolutionKind {
  RESTART
  CONFIG
  AUTO
  OTHER
}

enum MaintenanceScope {
  CUSTOMER
  PROJECT
  SERVICE
  ACCOUNT
  RESOURCE_TYPE
  ALERT
}

enum MonitoringTag {
