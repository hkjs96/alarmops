// AlarmOps PoC schema — implements docs/DATA-MODEL.md (draft, day 4).
// Postgres standard features only (D-09 principle 1). Schema changes only via `prisma migrate` (D-10).
// Partial unique indexes, CHECK constraints and NULLS NOT DISTINCT that Prisma cannot express
// are added as raw SQL at the end of migrations/0001_init/migration.sql.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext]
}

// ───────────────────────────── enums ─────────────────────────────

enum ConsoleRole {
  VIEWER
  OPERATOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum ContactKind {
  INTERNAL
  CUSTOMER
}

enum ScopeType {
  CUSTOMER
  PROJECT
  SERVICE
}

enum AssignmentScope {
  CUSTOMER
  PROJECT
  SERVICE
  ACCOUNT
}

enum ContactScopeRole {
  NOTIFY
  APPROVER
  PORTAL_USER
}

enum ResponderRole {
  PAGEABLE
  NOTIFY_ONLY
}

enum ResponderSource {
  TEMPLATE
  DIRECT
}

enum Environment {
  PRD
  STG
  DEV
}

enum RoleStatus {
  UNKNOWN
  OK
  DENIED
  MISSING
}

enum SourceKind {
  CLOUDWATCH
  PROMETHEUS
  GRAFANA
}

enum EventState {
  FIRING
  RESOLVED
  INSUFFICIENT_DATA
}

enum AlertStatus {
