{
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git switch:*)", "Bash(git checkout -b:*)", "Bash(git worktree:*)",
      "Bash(gh pr create:*)", "Bash(gh pr view:*)", "Bash(gh pr list:*)", "Bash(gh issue view:*)", "Bash(gh issue list:*)",
      "Bash(npm run:*)", "Bash(npm test:*)", "Bash(npm ci:*)", "Bash(npx vitest:*)", "Bash(npx tsc:*)",
      "Bash(npx prisma migrate dev:*)", "Bash(npx prisma generate:*)", "Bash(npx playwright test:*)",
      "Bash(python -m pytest:*)", "Bash(pytest:*)",
      "Bash(sam validate:*)", "Bash(sam build:*)", "Bash(cfn-lint:*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(~/.aws/**)", "Edit(./.claude/**)", "Write(./.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }
        ]
      }
    ]
  }
}
