# 개발용 값만. 실제 값은 .env에 두고 커밋하지 않는다. 값 구하는 법: docs/SETUP-SUPABASE.md

# ── 데이터베이스 (Supabase 개발 프로젝트, 서울) ──
# 앱이 평소에 쓰는 연결: 풀링(transaction) 주소, 포트 6543.
# Prisma가 이 주소로 동작하려면 끝에 ?pgbouncer=true&connection_limit=1 이 꼭 있어야 한다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
# 콘솔 안의 API(packages/store-sql)가 6543(transaction 풀러)에 붙을 때: transaction. 직접·세션(5432)이면 비워둔다.
DATABASE_POOLER=transaction
# 마이그레이션(prisma migrate) 전용 연결: 세션(session) 또는 직접(direct) 주소, 포트 5432.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── 콘솔 ──
# 로그인 세션 서명 키. 32자 이상 무작위 문자열. 만들기: openssl rand -base64 48
# MOCK_API=1 일 때만 비워둘 수 있다.
SESSION_SECRET=
# 콘솔의 공개 주소(예: https://console.example.com). 설정하면 이 주소에서 온 로그아웃 요청만 받는다. 운영에서는 필수, 로컬은 비워둔다.
CONSOLE_ORIGIN=
# 1 = 앞단 프록시가 Host를 바꾸고 X-Forwarded-Host를 덮어쓰는 경우에만. 그 밖에는 비워둔다(apps/console/README.md).
TRUSTED_PROXY=
# 1 = 백엔드 없이 가짜 데이터로 콘솔을 띄운다(로컬 개발·E2E 전용). 운영에서는 절대 켜지 않는다.
MOCK_API=1
# 1분 틱(POST /api/internal/tick) 공유 비밀. 32자 이상. 비우면 틱은 503(fail-closed). pg_cron 쪽은 Supabase Vault에 둔다.
TICK_SECRET=
# 1 = MOCK_API 없이(실제 API·DB) 개발용 로그인(/auth/dev-login, 시드 사용자). NODE_ENV=production이면 무시된다. 로컬·live e2e 전용.
LIVE_DEV_LOGIN=

# ── AWS (개발 계정만) ──
AWS_PROFILE=dev
AWS_REGION=ap-northeast-2

# ── 외부 연동 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SMS_PROVIDER_API_KEY=
SMS_SENDER_NUMBER=
ACK_LINK_SIGNING_SECRET=
